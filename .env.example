# Copia este archivo como .env.local y completa los valores (Supabase → Project Settings → API).
# .env.local no se sube al repo. En Vercel, estas mismas variables van en el panel del proyecto.
# Usa SOLO la clave anon (pública). Nunca la service_role.
# Si las dejas vacías, la app usa los datos de ejemplo de src/data/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
